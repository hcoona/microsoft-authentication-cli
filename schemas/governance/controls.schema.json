{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hcoona/microsoft-authentication-cli/schemas/governance/controls.schema.json",
  "title": "Control Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "controls"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/control"
      }
    }
  },
  "$defs": {
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "evaluator",
        "action",
        "fallback_review"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "evaluator": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "fallback_review": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "class",
        "enforcement",
        "producer",
        "maintainer",
        "consumers",
        "governing_rules",
        "invariant",
        "runner",
        "implementation",
        "execution_points",
        "failure_mode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "state": {
          "enum": [
            "current",
            "scheduled"
          ]
        },
        "class": {
          "enum": [
            "mechanical",
            "procedural-review",
            "owner-decision",
            "hybrid"
          ]
        },
        "enforcement": {
          "enum": [
            "advisory",
            "blocking",
            "review-required",
            "owner-disposition"
          ]
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "maintainer": {
          "type": "string",
          "minLength": 1
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "governing_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "invariant": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "enum": [
            "hk",
            "agent-skill",
            "human-owner",
            "github-platform"
          ]
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "enum": [
                "repository-path",
                "review-procedure",
                "evidence-carrier"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "execution_points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "local-fast",
              "ci",
              "pull-request-review",
              "recheck-trigger",
              "phase-transition",
              "issue-closure",
              "pull-request-merge",
              "release"
            ]
          },
          "uniqueItems": true
        },
        "failure_mode": {
          "type": "string",
          "minLength": 1
        },
        "activation": {
          "$ref": "#/$defs/activation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "scheduled"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "activation"
            ]
          },
          "else": {
            "not": {
              "required": [
                "activation"
              ]
            }
          }
        }
      ]
    }
  }
}
