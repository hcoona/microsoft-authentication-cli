{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hcoona/microsoft-authentication-cli/schemas/governance/record-families.schema.json",
  "title": "Record Family Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "families"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/family"
      }
    }
  },
  "$defs": {
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "evaluator",
        "action",
        "fallback_review"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "evaluator": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "fallback_review": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "concern",
        "carrier",
        "path",
        "format",
        "producer",
        "maintainer",
        "consumers",
        "creation_trigger",
        "failure_mode",
        "review_point"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "state": {
          "enum": [
            "current",
            "scheduled"
          ]
        },
        "concern": {
          "type": "string",
          "minLength": 1
        },
        "carrier": {
          "enum": [
            "repository-file",
            "repository-files"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "markdown",
            "yaml",
            "json",
            "json-schema",
            "jsonl",
            "csv",
            "mixed-bundle"
          ]
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "maintainer": {
          "type": "string",
          "minLength": 1
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "creation_trigger": {
          "type": "string",
          "minLength": 1
        },
        "failure_mode": {
          "type": "string",
          "minLength": 1
        },
        "review_point": {
          "type": "string",
          "minLength": 1
        },
        "activation": {
          "$ref": "#/$defs/activation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "scheduled"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "activation"
            ]
          },
          "else": {
            "not": {
              "required": [
                "activation"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "enum": [
                  "yaml",
                  "json",
                  "jsonl"
                ]
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "required": [
              "schema"
            ]
          }
        }
      ]
    }
  }
}
