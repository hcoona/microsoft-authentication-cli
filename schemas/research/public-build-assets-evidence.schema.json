{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hcoona/microsoft-authentication-cli/schemas/research/public-build-assets-evidence.schema.json",
  "title": "Phase 1 Public-Build Assets Evidence",
  "type": "object",
  "required": [
    "version",
    "targets",
    "libraries",
    "packageFolders",
    "project"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "package",
                "project"
              ]
            }
          }
        }
      }
    },
    "libraries": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "package",
              "project"
            ]
          }
        }
      }
    },
    "packageFolders": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object"
      }
    },
    "project": {
      "type": "object",
      "required": [
        "restore",
        "frameworks"
      ],
      "properties": {
        "restore": {
          "type": "object",
          "required": [
            "projectPath",
            "packagesPath",
            "configFilePaths",
            "sources",
            "frameworks"
          ],
          "properties": {
            "projectPath": {
              "type": "string",
              "minLength": 1
            },
            "packagesPath": {
              "type": "string",
              "minLength": 1
            },
            "configFilePaths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "sources": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object"
              }
            },
            "frameworks": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "required": [
                  "projectReferences"
                ],
                "properties": {
                  "projectReferences": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "required": [
                        "projectPath"
                      ],
                      "properties": {
                        "projectPath": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "frameworks": {
          "type": "object",
          "minProperties": 1
        }
      }
    }
  }
}
