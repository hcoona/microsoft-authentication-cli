{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hcoona/microsoft-authentication-cli/schemas/research/rechecks.schema.json",
  "title": "Upstream Recheck Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "governance",
    "rechecks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "rechecks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recheck"
      }
    }
  },
  "$defs": {
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator",
        "trigger_action",
        "fallback_review"
      ],
      "properties": {
        "evaluator": {
          "type": "string",
          "minLength": 1
        },
        "trigger_action": {
          "type": "string",
          "minLength": 1
        },
        "fallback_review": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "sources",
        "triggers",
        "required_outcome"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RECHECK-[0-9]{3}$"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/trigger"
          }
        },
        "required_outcome": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "decision",
            "release",
            "workstream"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
