{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hcoona/microsoft-authentication-cli/schemas/research/public-build-experiment-bundle.schema.json",
  "title": "Phase 1 Public-Build Experiment Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "authorization",
    "source",
    "environment",
    "isolation_profile",
    "protocol",
    "command_results",
    "dependency_inventory",
    "conclusions",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^EXP-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "in-progress",
        "completed",
        "aborted"
      ]
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "isolation_profile": {
      "$ref": "#/$defs/isolationProfile"
    },
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "command_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commandResult"
      }
    },
    "dependency_inventory": {
      "$ref": "#/$defs/dependencyInventory"
    },
    "conclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conclusion"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "completion": {
      "$ref": "#/$defs/completion"
    },
    "termination": {
      "$ref": "#/$defs/termination"
    },
    "lasso_analysis": {
      "$ref": "#/$defs/lassoAnalysis"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "completion",
          "lasso_analysis"
        ],
        "properties": {
          "command_results": {
            "$ref": "#/$defs/completedCommandResults"
          },
          "conclusions": {
            "minItems": 1
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "completion"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "aborted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "termination"
        ]
      },
      "else": {
        "not": {
          "required": [
            "termination"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "planned"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "command_results": {
            "maxItems": 0
          },
          "dependency_inventory": {
            "properties": {
              "restore_graphs": {
                "maxItems": 0
              }
            }
          },
          "conclusions": {
            "items": {
              "not": {
                "properties": {
                  "kind": {
                    "const": "runtime-observation"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^(?:/|[A-Za-z]:/).+"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "scope"
      ],
      "properties": {
        "issue": {
          "const": "https://github.com/hcoona/microsoft-authentication-cli/issues/1"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "checkout"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/AzureAD/microsoft-authentication-cli"
        },
        "commit": {
          "const": "de20930c34b3b86c8a0ed7bbdeeca3f662dae918"
        },
        "checkout": {
          "const": "detached"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "operating_system",
        "operating_system_family",
        "architecture",
        "host_type",
        "checkout_root",
        "dotnet_info_reference",
        "nuget_version",
        "build_entry_point",
        "configuration",
        "working_directory",
        "timeout_policy",
        "retry_policy"
      ],
      "properties": {
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "operating_system": {
          "type": "string",
          "minLength": 1
        },
        "operating_system_family": {
          "enum": [
            "linux",
            "windows",
            "macos"
          ]
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "host_type": {
          "type": "string",
          "minLength": 1
        },
        "checkout_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "dotnet_info_reference": {
          "type": "string",
          "minLength": 1
        },
        "nuget_version": {
          "type": "string",
          "minLength": 1
        },
        "build_entry_point": {
          "type": "string",
          "const": "AzureAuth.sln"
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        },
        "timeout_policy": {
          "type": "string",
          "minLength": 1
        },
        "working_directory": {
          "const": "detached-checkout-root"
        },
        "retry_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "isolationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "home_root",
        "global_packages_root",
        "http_cache_root",
        "plugin_cache_root",
        "scratch_root",
        "inherit_user_nuget_configuration",
        "inherit_machine_nuget_configuration",
        "allow_package_source_credentials",
        "allow_credential_providers",
        "allow_credential_environment",
        "initial_cache_state",
        "scratch_contents"
      ],
      "properties": {
        "id": {
          "const": "issue-1-clean-nuget"
        },
        "home_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "global_packages_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "http_cache_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "plugin_cache_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "scratch_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "inherit_user_nuget_configuration": {
          "const": false
        },
        "inherit_machine_nuget_configuration": {
          "const": false
        },
        "allow_package_source_credentials": {
          "const": false
        },
        "allow_credential_providers": {
          "const": false
        },
        "allow_credential_environment": {
          "const": false
        },
        "initial_cache_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "global_packages",
            "http",
            "plugins"
          ],
          "properties": {
            "global_packages": {
              "const": "empty"
            },
            "http": {
              "const": "empty"
            },
            "plugins": {
              "const": "empty"
            }
          }
        },
        "scratch_contents": {
          "const": "reviewed-public-config-only"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "prerequisites",
        "expected_observations",
        "stop_conditions",
        "cleanup",
        "attempted_targets",
        "stage_applicability",
        "restore_configurations",
        "commands"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "prerequisites": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "expected_observations": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "stop_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "cleanup": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "attempted_targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/attemptedTarget"
          }
        },
        "stage_applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "build",
            "test",
            "package"
          ],
          "properties": {
            "build": {
              "$ref": "#/$defs/stageApplicability"
            },
            "test": {
              "$ref": "#/$defs/stageApplicability"
            },
            "package": {
              "$ref": "#/$defs/stageApplicability"
            }
          }
        },
        "restore_configurations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/restoreConfiguration"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "source_mode": {
                    "const": "source-faithful"
                  }
                },
                "required": [
                  "source_mode"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "source_mode": {
                    "const": "public-only"
                  }
                },
                "required": [
                  "source_mode"
                ]
              }
            }
          ]
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/protocolCommand"
          }
        }
      }
    },
    "attemptedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project_path",
        "target_framework",
        "sdk",
        "project_references"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "project_path": {
          "type": "string",
          "pattern": "^src/.+\\.csproj$"
        },
        "target_framework": {
          "const": "net8.0"
        },
        "sdk": {
          "const": "Microsoft.NET.Sdk"
        },
        "project_references": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^src/.+\\.csproj$"
          },
          "uniqueItems": true
        }
      }
    },
    "protocolCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "source_mode",
        "restore_configuration_id",
        "command",
        "depends_on",
        "expected_observations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "stage": {
          "enum": [
            "restore",
            "build",
            "test",
            "package"
          ]
        },
        "source_mode": {
          "enum": [
            "source-faithful",
            "public-only"
          ]
        },
        "restore_configuration_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "command": {
          "$ref": "#/$defs/commandInvocation"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "expected_observations": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "commandInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "arguments"
      ],
      "properties": {
        "executable": {
          "const": "dotnet"
        },
        "arguments": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stageApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "reason",
        "evidence_references"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicable": {
                "const": true
              }
            },
            "required": [
              "applicable"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "const": null
              },
              "evidence_references": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidence_references": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "restoreConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_mode",
        "origin",
        "path",
        "canonical_path",
        "symlink_free",
        "path_identity_evidence_references",
        "sha256",
        "content_base64",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "source_mode": {
          "enum": [
            "source-faithful",
            "public-only"
          ]
        },
        "origin": {
          "enum": [
            "audited-upstream",
            "isolated-public"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "canonical_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "symlink_free": {
          "const": true
        },
        "path_identity_evidence_references": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_base64": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_mode": {
                "const": "source-faithful"
              }
            },
            "required": [
              "source_mode"
            ]
          },
          "then": {
            "properties": {
              "origin": {
                "const": "audited-upstream"
              },
              "path": {
                "const": "nuget.config"
              },
              "sha256": {
                "const": "be2776f78f5af30efb8836a32c4467ca0dcd9220c17d778ed8332b33dd309a6b"
              },
              "content_base64": {
                "const": null
              },
              "sources": {
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [
                  {
                    "const": "https://pkgs.dev.azure.com/office/_packaging/Office/nuget/v3/index.json"
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "origin": {
                "const": "isolated-public"
              },
              "path": {
                "$ref": "#/$defs/absolutePath"
              },
              "sha256": {
                "const": "f545a7e2ea14ac53cdfb91217cae67b8ff14275313f6298f9a3331d205b6c948"
              },
              "content_base64": {
                "const": "PD94bWwgdmVyc2lvbj0iMS4wIiBlbmNvZGluZz0idXRmLTgiPz4KPGNvbmZpZ3VyYXRpb24+CiAgPHBhY2thZ2VTb3VyY2VzPgogICAgPGNsZWFyIC8+CiAgICA8YWRkIGtleT0ibnVnZXQub3JnIiB2YWx1ZT0iaHR0cHM6Ly9hcGkubnVnZXQub3JnL3YzL2luZGV4Lmpzb24iIHByb3RvY29sVmVyc2lvbj0iMyIgLz4KICA8L3BhY2thZ2VTb3VyY2VzPgo8L2NvbmZpZ3VyYXRpb24+Cg=="
              },
              "sources": {
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [
                  {
                    "const": "https://api.nuget.org/v3/index.json"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "restoreExecutionIntegrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification",
        "inherited_nuget_configuration",
        "package_source_credentials",
        "credential_providers",
        "credential_environment",
        "initial_cache_state",
        "scratch_contents",
        "sanitized_evidence_references",
        "violation_summary"
      ],
      "properties": {
        "verification": {
          "enum": [
            "verified",
            "violated"
          ]
        },
        "inherited_nuget_configuration": {
          "enum": [
            "none",
            "detected",
            "unknown"
          ]
        },
        "package_source_credentials": {
          "enum": [
            "none",
            "detected",
            "unknown"
          ]
        },
        "credential_providers": {
          "enum": [
            "not-invoked",
            "invoked",
            "unknown"
          ]
        },
        "credential_environment": {
          "enum": [
            "none",
            "detected",
            "unknown"
          ]
        },
        "initial_cache_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "global_packages",
            "http",
            "plugins"
          ],
          "properties": {
            "global_packages": {
              "enum": [
                "empty",
                "populated",
                "unknown"
              ]
            },
            "http": {
              "enum": [
                "empty",
                "populated",
                "unknown"
              ]
            },
            "plugins": {
              "enum": [
                "empty",
                "populated",
                "unknown"
              ]
            }
          }
        },
        "scratch_contents": {
          "enum": [
            "reviewed-public-config-only",
            "unexpected",
            "unknown"
          ]
        },
        "sanitized_evidence_references": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "violation_summary": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification": {
                "const": "verified"
              }
            },
            "required": [
              "verification"
            ]
          },
          "then": {
            "properties": {
              "inherited_nuget_configuration": {
                "const": "none"
              },
              "package_source_credentials": {
                "const": "none"
              },
              "credential_providers": {
                "const": "not-invoked"
              },
              "credential_environment": {
                "const": "none"
              },
              "initial_cache_state": {
                "properties": {
                  "global_packages": {
                    "const": "empty"
                  },
                  "http": {
                    "const": "empty"
                  },
                  "plugins": {
                    "const": "empty"
                  }
                }
              },
              "scratch_contents": {
                "const": "reviewed-public-config-only"
              },
              "violation_summary": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "violation_summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "stage",
        "source_commit",
        "environment_fingerprint",
        "source_mode",
        "isolation_profile_id",
        "command",
        "status",
        "exit_code",
        "sanitized_evidence_references",
        "reproduction_count",
        "limitations"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "stage": {
          "enum": [
            "restore",
            "build",
            "test",
            "package"
          ]
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "environment_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "source_mode": {
          "enum": [
            "source-faithful",
            "public-only"
          ]
        },
        "isolation_profile_id": {
          "const": "issue-1-clean-nuget"
        },
        "command": {
          "$ref": "#/$defs/commandInvocation"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not-applicable"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sanitized_evidence_references": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "blocked_by": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "reproduction_count": {
          "type": "integer",
          "minimum": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "execution_integrity": {
          "$ref": "#/$defs/restoreExecutionIntegrity"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              },
              "reproduction_count": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
