{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hcoona/microsoft-authentication-cli/schemas/research/public-build-experiment-bundle.schema.json",
  "title": "Phase 1 Public-Build Experiment Bundle",
  "description": "Strict Issue #1 singleton plan and runner-produced evidence contract.",
  "x-public-build-contract": {
    "mode": "runtime",
    "version": 2,
    "runtime_property": "runtime_evidence",
    "runtime_root": "#/$defs/runtimeEvidence",
    "runtime_semantics": {
      "command_outcomes": "#/$defs/runtimeEvidence/properties/command_outcomes",
      "canonical_termination": "#/$defs/runtimeEvidence/properties/canonical_termination",
      "all_exit_quiescence": "#/$defs/runtimeEvidence/properties/all_exit_quiescence",
      "ownership_conditioned_cleanup": "#/$defs/runtimeEvidence/properties/ownership_conditioned_cleanup",
      "receipt_binding": "#/$defs/runtimeEvidence/properties/receipt_binding",
      "bounded_conclusions": "#/$defs/runtimeEvidence/properties/bounded_conclusions"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "issue",
    "authorities",
    "components",
    "environment",
    "isolation",
    "protocol",
    "limitations",
    "policy_reference"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "public-build-linux-x64-dotnet-8-0-424-01"
    },
    "status": {
      "enum": [
        "planned",
        "recorded"
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "url"
      ],
      "properties": {
        "number": {
          "const": 1
        },
        "url": {
          "const": "https://github.com/hcoona/microsoft-authentication-cli/issues/1"
        }
      }
    },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_baseline",
        "lasso_manifest"
      ],
      "properties": {
        "source_baseline": {
          "$ref": "#/$defs/sourceAuthority"
        },
        "lasso_manifest": {
          "$ref": "#/$defs/lassoAuthority"
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "contract",
        "validator",
        "extractor",
        "nuget_versions",
        "schema",
        "lockfile"
      ],
      "properties": {
        "runner": {
          "$ref": "#/$defs/repositoryComponent"
        },
        "contract": {
          "$ref": "#/$defs/repositoryComponent"
        },
        "validator": {
          "$ref": "#/$defs/repositoryComponent"
        },
        "extractor": {
          "$ref": "#/$defs/repositoryComponent"
        },
        "nuget_versions": {
          "$ref": "#/$defs/repositoryComponent"
        },
        "schema": {
          "$ref": "#/$defs/repositoryComponent"
        },
        "lockfile": {
          "$ref": "#/$defs/repositoryComponent"
        }
      }
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "isolation": {
      "$ref": "#/$defs/isolation"
    },
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonemptyString"
      },
      "minItems": 3,
      "uniqueItems": true
    },
    "policy_reference": {
      "const": "docs/research/experiment-safety.md#phase-1-public-build-record"
    },
    "runtime_evidence": {
      "$ref": "#/$defs/runtimeEvidence"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "planned"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "required": [
            "runtime_evidence"
          ]
        }
      },
      "else": {
        "required": [
          "runtime_evidence"
        ]
      }
    }
  ],
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha512": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "absolutePosixPath": {
      "type": "string",
      "pattern": "^/(?:[^\\u0000/]*/)*[^\\u0000/]*$"
    },
    "reference": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:/[a-z][a-z0-9-]*)?$"
    },
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "payload_sha256"
      ],
      "properties": {
        "path": {
          "const": "docs/research/public-build-source-baseline.json"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "lassoAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "payload_sha256"
      ],
      "properties": {
        "path": {
          "const": "docs/research/public-build-lasso-reference-manifest.json"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "repositoryComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:tools/[^\\u0000]+|schemas/research/[^\\u0000]+)$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_type",
        "runtime_identifier",
        "mise",
        "dotnet_sdk"
      ],
      "properties": {
        "host_type": {
          "const": "native-linux"
        },
        "runtime_identifier": {
          "const": "linux-x64"
        },
        "mise": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "tool_name",
            "executable_sha256",
            "executable_source",
            "config_content"
          ],
          "properties": {
            "version": {
              "const": "2026.8.10"
            },
            "tool_name": {
              "const": "http:dotnet-sdk"
            },
            "executable_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "executable_source": {
              "$ref": "#/$defs/nonemptyString"
            },
            "config_content": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        "dotnet_sdk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "archive_url",
            "archive_sha512",
            "manager_data_root",
            "installation_root",
            "host_path",
            "global_json_path",
            "global_json_content"
          ],
          "properties": {
            "version": {
              "const": "8.0.424"
            },
            "archive_url": {
              "const": "https://builds.dotnet.microsoft.com/dotnet/Sdk/8.0.424/dotnet-sdk-8.0.424-linux-x64.tar.gz"
            },
            "archive_sha512": {
              "$ref": "#/$defs/sha512"
            },
            "manager_data_root": {
              "$ref": "#/$defs/absolutePosixPath"
            },
            "installation_root": {
              "$ref": "#/$defs/absolutePosixPath"
            },
            "host_path": {
              "$ref": "#/$defs/absolutePosixPath"
            },
            "global_json_path": {
              "$ref": "#/$defs/absolutePosixPath"
            },
            "global_json_content": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        }
      }
    },
    "sourceModeIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "configuration",
        "package_sources",
        "checkout_root",
        "home_root",
        "nuget_packages_root",
        "nuget_http_cache_root",
        "nuget_plugins_cache_root",
        "nuget_scratch_root",
        "temporary_root",
        "obj_root",
        "bin_root",
        "package_output_root",
        "generated_nuget_config",
        "generated_directory_packages_props"
      ],
      "properties": {
        "id": {
          "enum": [
            "source-faithful",
            "public-only"
          ]
        },
        "configuration": {
          "enum": [
            "audited-checkout",
            "isolated-generated"
          ]
        },
        "package_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "checkout_root": {
          "$ref": "#/$defs/absolutePosixPath"
        },
        "home_root": {
          "$ref": "#/$defs/absolutePosixPath"
        },
        "nuget_packages_root": {
          "$ref": "#/$defs/absolutePosixPath"
        },
        "nuget_http_cache_root": {
          "$ref": "#/$defs/absolutePosixPath"
        },
        "nuget_plugins_cache_root": {
          "$ref": "#/$defs/absolutePosixPath"
        },
        "nuget_scratch_root": {
          "$ref": "#/$defs/absolutePosixPath"
        },
        "temporary_root": {
          "$ref": "#/$defs/absolutePosixPath"
        },
        "obj_root": {
          "$ref": "#/$defs/absolutePosixPath"
        },
        "bin_root": {
          "$ref": "#/$defs/absolutePosixPath"
        },
        "package_output_root": {
          "$ref": "#/$defs/absolutePosixPath"
        },
        "generated_directory_packages_props": {
          "$ref": "#/$defs/absolutePosixPath"
        },
        "generated_nuget_config": {
          "oneOf": [
            {
              "$ref": "#/$defs/absolutePosixPath"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolchain_root",
        "selection_root",
        "source_modes",
        "replacement_environment"
      ],
      "properties": {
        "toolchain_root": {
          "$ref": "#/$defs/absolutePosixPath"
        },
        "selection_root": {
          "$ref": "#/$defs/absolutePosixPath"
        },
        "source_modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceModeIsolation"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "replacement_environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowlist"
          ],
          "properties": {
            "allowlist": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "minItems": 16,
              "uniqueItems": true
            }
          }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_mode",
        "stage",
        "target",
        "depends_on",
        "argv",
        "cwd",
        "max_attempts",
        "timeout_seconds",
        "test_filter"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:source-faithful|public-only)-(?:restore|build|test|package-adopat|package-azureauth|package-msalwrapper-benchmark|package-msalwrapper|package-testhelper)$"
        },
        "source_mode": {
          "enum": [
            "source-faithful",
            "public-only"
          ]
        },
        "stage": {
          "enum": [
            "restore",
            "build",
            "test",
            "package"
          ]
        },
        "target": {
          "enum": [
            "AzureAuth.sln",
            "src/AdoPat/AdoPat.csproj",
            "src/AzureAuth/AzureAuth.csproj",
            "src/MSALWrapper.Benchmark/MSALWrapper.Benchmark.csproj",
            "src/MSALWrapper/MSALWrapper.csproj",
            "src/TestHelper/TestHelper.csproj"
          ]
        },
        "depends_on": {
          "oneOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "argv": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonemptyString"
          },
          "minItems": 3
        },
        "cwd": {
          "$ref": "#/$defs/absolutePosixPath"
        },
        "max_attempts": {
          "const": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "test_filter": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonemptyString"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "supervision_bounds",
        "expected_observations"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          },
          "minItems": 16,
          "maxItems": 16
        },
        "supervision_bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "descendant_discovery_pass_seconds",
            "max_discovered_processes",
            "fixed_point_seconds",
            "capture_reader_grace_seconds",
            "capture_reader_shutdown_seconds",
            "source_max_entries",
            "source_per_file_bytes",
            "source_aggregate_bytes",
            "source_elapsed_seconds"
          ],
          "properties": {
            "descendant_discovery_pass_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.25
            },
            "max_discovered_processes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            },
            "fixed_point_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 2.0
            },
            "capture_reader_grace_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.5
            },
            "capture_reader_shutdown_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 2.0
            },
            "source_max_entries": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            },
            "source_per_file_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "source_aggregate_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 268435456
            },
            "source_elapsed_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 30.0
            }
          }
        },
        "expected_observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source_mode",
              "stage",
              "expectation"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/reference"
              },
              "source_mode": {
                "enum": [
                  "source-faithful",
                  "public-only",
                  "both"
                ]
              },
              "stage": {
                "enum": [
                  "restore",
                  "package"
                ]
              },
              "expectation": {
                "$ref": "#/$defs/nonemptyString"
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "outputEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "path",
        "sha256",
        "sanitized_bytes",
        "excerpt",
        "truncated"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "retained-sanitized",
            "suppressed-source-faithful",
            "capture-unverifiable"
          ]
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/absolutePosixPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "sanitized_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "excerpt": {
          "type": "string",
          "maxLength": 20000
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "properties": {
            "disposition": {
              "const": "retained-sanitized"
            },
            "path": {
              "$ref": "#/$defs/absolutePosixPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "properties": {
            "disposition": {
              "const": "suppressed-source-faithful"
            },
            "path": {
              "const": null
            },
            "sha256": {
              "const": null
            },
            "sanitized_bytes": {
              "const": 0
            },
            "excerpt": {
              "const": ""
            },
            "truncated": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "disposition": {
              "const": "capture-unverifiable"
            },
            "path": {
              "const": null
            },
            "sha256": {
              "const": null
            },
            "sanitized_bytes": {
              "const": 0
            },
            "excerpt": {
              "const": ""
            },
            "truncated": {
              "const": false
            }
          }
        }
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "exit_code",
        "termination",
        "stdout",
        "stderr",
        "failure_reason"
      ],
      "properties": {
        "attempt": {
          "const": 1
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "termination": {
          "enum": [
            "completed",
            "cancelled",
            "timed-out",
            "quiescence-unproved",
            "sensitive-output",
            "output-limit-exceeded",
            "capture-failed"
          ]
        },
        "stdout": {
          "$ref": "#/$defs/outputEvidence"
        },
        "stderr": {
          "$ref": "#/$defs/outputEvidence"
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stdout": {
                "properties": {
                  "disposition": {
                    "const": "capture-unverifiable"
                  }
                },
                "required": [
                  "disposition"
                ]
              }
            },
            "required": [
              "stdout"
            ]
          },
          "then": {
            "properties": {
              "stdout": {
                "properties": {
                  "disposition": {
                    "const": "capture-unverifiable"
                  }
                },
                "required": [
                  "disposition"
                ]
              },
              "stderr": {
                "properties": {
                  "disposition": {
                    "const": "capture-unverifiable"
                  }
                },
                "required": [
                  "disposition"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stderr": {
                "properties": {
                  "disposition": {
                    "const": "capture-unverifiable"
                  }
                },
                "required": [
                  "disposition"
                ]
              }
            },
            "required": [
              "stderr"
            ]
          },
          "then": {
            "properties": {
              "stdout": {
                "properties": {
                  "disposition": {
                    "const": "capture-unverifiable"
                  }
                },
                "required": [
                  "disposition"
                ]
              },
              "stderr": {
                "properties": {
                  "disposition": {
                    "const": "capture-unverifiable"
                  }
                },
                "required": [
                  "disposition"
                ]
              }
            }
          }
        }
      ]
    },
    "commandOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "status",
        "attempts",
        "unspawned_termination",
        "source_integrity_failure",
        "blocked_by"
      ],
      "properties": {
        "command_id": {
          "$ref": "#/$defs/reference"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          },
          "maxItems": 1
        },
        "unspawned_termination": {
          "enum": [
            "spawn-failed",
            "capture-failed",
            null
          ]
        },
        "source_integrity_failure": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        },
        "blocked_by": {
          "oneOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "preparationOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "attempts",
        "failure_reason"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/reference"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          },
          "maxItems": 1
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        }
      }
    },
    "quiescenceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_kind",
        "subject_id",
        "proved",
        "descendant_fixed_point",
        "final_live_descendants",
        "reaped_processes"
      ],
      "properties": {
        "subject_kind": {
          "enum": [
            "preparation",
            "command"
          ]
        },
        "subject_id": {
          "$ref": "#/$defs/reference"
        },
        "proved": {
          "type": "boolean"
        },
        "descendant_fixed_point": {
          "type": "boolean"
        },
        "final_live_descendants": {
          "type": "integer",
          "minimum": 0
        },
        "reaped_processes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cacheObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_mode",
        "kind",
        "preparation_refs",
