{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hcoona/microsoft-authentication-cli/schemas/research/public-build-experiment-bundle.schema.json",
  "title": "Phase 1 Public-Build Experiment Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "authorization",
    "source",
    "environment",
    "isolation_controls",
    "protocol",
    "command_results",
    "dependency_inventory",
    "conclusions",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^EXP-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "in-progress",
        "completed",
        "aborted"
      ]
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "isolation_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/isolationControl"
      }
    },
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "command_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commandResult"
      }
    },
    "dependency_inventory": {
      "$ref": "#/$defs/dependencyInventory"
    },
    "conclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conclusion"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "scope"
      ],
      "properties": {
        "issue": {
          "type": "string",
          "format": "uri"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "checkout"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "checkout": {
          "const": "detached"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "operating_system",
        "architecture",
        "host_type",
        "dotnet_info_reference",
        "nuget_version",
        "build_entry_point",
        "configuration",
        "timeout_policy",
        "retry_policy"
      ],
      "properties": {
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "operating_system": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "host_type": {
          "type": "string",
          "minLength": 1
        },
        "dotnet_info_reference": {
          "type": "string",
          "minLength": 1
        },
        "nuget_version": {
          "type": "string",
          "minLength": 1
        },
        "build_entry_point": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        },
        "timeout_policy": {
          "type": "string",
          "minLength": 1
        },
        "retry_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "isolationControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "prerequisites",
        "expected_observations",
        "stop_conditions",
        "cleanup",
        "commands"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "prerequisites": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "expected_observations": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "stop_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "cleanup": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/protocolCommand"
          }
        }
      }
    },
    "protocolCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "source_mode",
        "command",
        "depends_on",
        "expected_observations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "stage": {
          "enum": [
            "restore",
            "build",
            "test",
            "package"
          ]
        },
        "source_mode": {
          "enum": [
            "source-faithful",
            "public-only"
          ]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "expected_observations": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "stage",
        "source_commit",
        "environment_fingerprint",
        "source_mode",
        "isolation_control_ids",
        "command",
        "status",
        "exit_code",
        "sanitized_evidence_references",
        "reproduction_count",
        "limitations"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "stage": {
          "enum": [
            "restore",
            "build",
            "test",
            "package"
          ]
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "environment_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "source_mode": {
          "enum": [
            "source-faithful",
            "public-only"
          ]
        },
        "isolation_control_ids": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not-applicable"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sanitized_evidence_references": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "reproduction_count": {
          "type": "integer",
          "minimum": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "dependencyInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_declared_direct",
        "resolved",
        "unresolved"
      ],
      "properties": {
        "source_declared_direct": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/directDependency"
          }
        },
        "resolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resolvedDependency"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unresolvedDependency"
          }
        }
      }
    },
    "directDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version_constraint",
        "declaration_location",
        "targets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version_constraint": {
          "type": "string",
          "minLength": 1
        },
        "declaration_location": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "resolvedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "retrieval_source",
        "observed_in",
        "targets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "retrieval_source": {
          "type": "string",
          "minLength": 1
        },
        "observed_in": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "targets": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "unresolvedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version_constraint",
        "requested_by",
        "failure_point",
        "observed_in",
        "unknown_transitive_scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version_constraint": {
          "type": "string",
          "minLength": 1
        },
        "requested_by": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "failure_point": {
          "type": "string",
          "minLength": 1
        },
        "observed_in": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "unknown_transitive_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "statement",
        "evidence_references"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source-finding",
            "runtime-observation",
            "inference",
            "hypothesis"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence_references": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    }
  }
}
