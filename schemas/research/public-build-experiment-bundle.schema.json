{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hcoona/microsoft-authentication-cli/schemas/research/public-build-experiment-bundle.schema.json",
  "title": "Phase 1 Public-Build Experiment Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "authorization",
    "source",
    "environment",
    "isolation_controls",
    "protocol",
    "command_results",
    "dependency_inventory",
    "conclusions",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^EXP-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "in-progress",
        "completed",
        "aborted"
      ]
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "isolation_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/isolationControl"
      }
    },
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "command_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commandResult"
      }
    },
    "dependency_inventory": {
      "$ref": "#/$defs/dependencyInventory"
    },
    "conclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conclusion"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "completion": {
      "$ref": "#/$defs/completion"
    },
    "termination": {
      "$ref": "#/$defs/termination"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "completion"
        ],
        "properties": {
          "command_results": {
            "$ref": "#/$defs/completedCommandResults"
          },
          "conclusions": {
            "minItems": 1
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "completion"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "aborted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "termination"
        ]
      },
      "else": {
        "not": {
          "required": [
            "termination"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "planned"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "command_results": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "scope"
      ],
      "properties": {
        "issue": {
          "const": "https://github.com/hcoona/microsoft-authentication-cli/issues/1"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "checkout"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/AzureAD/microsoft-authentication-cli"
        },
        "commit": {
          "const": "de20930c34b3b86c8a0ed7bbdeeca3f662dae918"
        },
        "checkout": {
          "const": "detached"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "operating_system",
        "architecture",
        "host_type",
        "dotnet_info_reference",
        "nuget_version",
        "build_entry_point",
        "configuration",
        "timeout_policy",
        "retry_policy"
      ],
      "properties": {
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "operating_system": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "host_type": {
          "type": "string",
          "minLength": 1
        },
        "dotnet_info_reference": {
          "type": "string",
          "minLength": 1
        },
        "nuget_version": {
          "type": "string",
          "minLength": 1
        },
        "build_entry_point": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        },
        "timeout_policy": {
          "type": "string",
          "minLength": 1
        },
        "retry_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "isolationControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "prerequisites",
        "expected_observations",
        "stop_conditions",
        "cleanup",
        "stage_applicability",
        "restore_configurations",
        "commands"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "prerequisites": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "expected_observations": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "stop_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "cleanup": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "stage_applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "build",
            "test",
            "package"
          ],
          "properties": {
            "build": {
              "$ref": "#/$defs/stageApplicability"
            },
            "test": {
              "$ref": "#/$defs/stageApplicability"
            },
            "package": {
              "$ref": "#/$defs/stageApplicability"
            }
          }
        },
        "restore_configurations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/restoreConfiguration"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "source_mode": {
                    "const": "source-faithful"
                  }
                },
                "required": [
                  "source_mode"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "source_mode": {
                    "const": "public-only"
                  }
                },
                "required": [
                  "source_mode"
                ]
              }
            }
          ]
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/protocolCommand"
          }
        }
      }
    },
    "protocolCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "source_mode",
        "restore_configuration_id",
        "command",
        "depends_on",
        "expected_observations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "stage": {
          "enum": [
            "restore",
            "build",
            "test",
            "package"
          ]
        },
        "source_mode": {
          "enum": [
            "source-faithful",
            "public-only"
          ]
        },
        "restore_configuration_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "command": {
          "$ref": "#/$defs/commandInvocation"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "expected_observations": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "commandInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "arguments"
      ],
      "properties": {
        "executable": {
          "const": "dotnet"
        },
        "arguments": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stageApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "reason",
        "evidence_references"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicable": {
                "const": true
              }
            },
            "required": [
              "applicable"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "const": null
              },
              "evidence_references": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidence_references": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "restoreConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_mode",
        "origin",
        "path",
        "sha256",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "source_mode": {
          "enum": [
            "source-faithful",
            "public-only"
          ]
        },
        "origin": {
          "enum": [
            "audited-upstream",
            "isolated-public"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sources": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "stage",
        "source_commit",
        "environment_fingerprint",
        "source_mode",
        "isolation_control_ids",
        "command",
        "status",
        "exit_code",
        "sanitized_evidence_references",
        "reproduction_count",
        "limitations"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "stage": {
          "enum": [
            "restore",
            "build",
            "test",
            "package"
          ]
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "environment_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "source_mode": {
          "enum": [
            "source-faithful",
            "public-only"
          ]
        },
        "isolation_control_ids": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "command": {
          "$ref": "#/$defs/commandInvocation"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not-applicable"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sanitized_evidence_references": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "blocked_by": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "reproduction_count": {
          "type": "integer",
          "minimum": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              },
              "reproduction_count": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "integer",
                "not": {
                  "const": 0
                }
              },
              "reproduction_count": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "blocked",
                  "not-applicable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": null
              },
              "reproduction_count": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "completedCommandResults": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "allOf": [
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "restore"
              },
              "source_mode": {
                "const": "source-faithful"
              }
            },
            "required": [
              "stage",
              "source_mode"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "restore"
              },
              "source_mode": {
                "const": "public-only"
              }
            },
            "required": [
              "stage",
              "source_mode"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "build"
              },
              "source_mode": {
                "const": "source-faithful"
              }
            },
            "required": [
              "stage",
              "source_mode"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "build"
              },
              "source_mode": {
                "const": "public-only"
              }
            },
            "required": [
              "stage",
              "source_mode"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "test"
              },
              "source_mode": {
                "const": "source-faithful"
              }
            },
            "required": [
              "stage",
              "source_mode"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "test"
              },
              "source_mode": {
                "const": "public-only"
              }
            },
            "required": [
              "stage",
              "source_mode"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "package"
              },
              "source_mode": {
                "const": "source-faithful"
              }
            },
            "required": [
              "stage",
              "source_mode"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "package"
              },
              "source_mode": {
                "const": "public-only"
              }
            },
            "required": [
              "stage",
              "source_mode"
            ]
          }
        }
      ]
    },
    "dependencyInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_declared_direct",
        "resolved",
        "unresolved"
      ],
      "properties": {
        "source_declared_direct": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/directDependency"
          }
        },
        "resolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resolvedDependency"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unresolvedDependency"
          }
        }
      }
    },
    "directDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration_id",
        "id",
        "kind",
        "version_constraint",
        "declaration_location",
        "targets"
      ],
      "properties": {
        "declaration_id": {
          "type": "string",
          "pattern": "^decl-[a-z0-9][a-z0-9-]*$"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/dependencyKind"
        },
        "version_constraint": {
          "type": "string",
          "minLength": 1
        },
        "declaration_location": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "dependencyObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "retrieval_source",
        "access",
        "cache_state",
        "targets"
      ],
      "properties": {
        "result_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "retrieval_source": {
          "type": "string",
          "minLength": 1
        },
        "access": {
          "enum": [
            "anonymous",
            "authenticated",
            "unknown"
          ]
        },
        "cache_state": {
          "enum": [
            "empty",
            "populated",
            "unknown"
          ]
        },
        "targets": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "resolvedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "version",
        "declaration_ids",
        "observations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/dependencyKind"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "declaration_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^decl-[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dependencyObservation"
          }
        }
      }
    },
    "unresolvedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "version_constraint",
        "declaration_ids",
        "requested_by",
        "failure_point",
        "observations",
        "unknown_transitive_scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/dependencyKind"
        },
        "version_constraint": {
          "type": "string",
          "minLength": 1
        },
        "declaration_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^decl-[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "requested_by": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "failure_point": {
          "type": "string",
          "minLength": 1
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dependencyObservation"
          }
        },
        "unknown_transitive_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependencyKind": {
      "enum": [
        "package",
        "tool",
        "sdk"
      ]
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "statement",
        "evidence_references"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source-finding",
            "runtime-observation",
            "inference",
            "hypothesis"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence_references": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "sanitized_evidence_references",
        "untested_environments"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "publicly-reproducible",
            "not-publicly-reproducible",
            "inconclusive"
          ]
        },
        "sanitized_evidence_references": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "untested_environments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "triggered_stop_condition",
        "cleanup_outcome",
        "sanitized_evidence_references"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "triggered_stop_condition": {
          "type": "string",
          "minLength": 1
        },
