amends "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Builtins.pkl"

env {
  ["PYTHONDONTWRITEBYTECODE"] = "1"
}

local textRecordSelectors = List(
  new FileSelector { types = List("text") },
  new FileSelector { glob = "docs/**/*.tm7" },
  new FileSelector { glob = "**/nuget.config" },
)

local fastSteps = new Mapping<String, Step> {
  ["merge-conflict"] = (Builtins.check_merge_conflict) {
    types = null
    match_any = textRecordSelectors
  }
  ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
    types = null
    match_any = textRecordSelectors
  }
  ["gitleaks"] = (Builtins.gitleaks) {
    types = null
    match_any = textRecordSelectors
  }
  ["markdown-links"] {
    check = new Command {
      argv = List(
        "lychee",
        "--offline",
        "--no-progress",
        "--include-fragments=full",
        "*.md",
        "docs/**/*.md",
        ".github/**/*.md",
      )
    }
  }
  ["structured-record-schema"] {
    check = new Command {
      argv = List("uv", "run", "--locked", "tools/check_repository_records.py", "schemas")
    }
  }
  ["record-identifiers"] {
    check = new Command {
      argv = List("uv", "run", "--locked", "tools/check_repository_records.py", "identifiers")
    }
  }
  ["record-family-path-consistency"] {
    check = new Command {
      argv = List(
        "uv",
        "run",
        "--locked",
        "tools/check_repository_records.py",
        "catalog-paths",
      )
    }
  }
  // global.json is generated from the SDK locked in mise.lock (global.pkl).
  ["global-json"] {
    glob = List("global.pkl", "global.json", "mise.lock")
    // The fix regenerates only global.json; restage nothing else.
    stage = List("global.json")
    check = "pkl eval -f json global.pkl | git diff --no-index --exit-code -- global.json -"
    fix = "pkl eval -f json global.pkl -o global.json"
  }
}

local preCommitSteps = new Mapping<String, Step> {
  ["staged-worktree-consistency"] {
    exclusive = true
    check = new Command {
      argv = List("uv", "run", "tools/check_staged_worktree.py")
    }
  }
  ...fastSteps
}

local fullSteps = new Mapping<String, Step> {
  ...fastSteps
  ["gitleaks-history"] {
    check = new Command {
      argv = List("uv", "run", "tools/check_git_history_secrets.py")
    }
  }
  ["actionlint"] = Builtins.actionlint
}

hooks {
  ["pre-commit"] {
    steps = preCommitSteps
  }
  ["fix"] {
    fix = true
    // Generated dependency locks are inspected but never rewritten (record-system Formats).
    steps = (fastSteps) {
      ["trailing-whitespace"] {
        exclude = List(
          "**/packages.lock.json",
          "mise.lock",
          "apm.lock.yaml",
          "tools/check_repository_records.py.lock",
          "tools/learn-cli/package-lock.json",
        )
      }
    }
  }
  ["check"] {
    steps = fullSteps
  }
}
