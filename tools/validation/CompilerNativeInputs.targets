  <!--
    BuildFrameworkLib's accepted dependencies only establish properties; this guard
    stops its recursive body. IlcCompile's BeforeTargets runs after its dependencies
    and before its Exec body. It is a fail-closed backstop, not the capture cutoff.
    LinkNative alone would be too late to guard ILC.
  -->
  <Target Name="_Issue108NativeExecutionForbidden5033607"
          BeforeTargets="BuildFrameworkLib;IlcCompile;LinkNative"
          Condition="'false' == 'true'">
    <Error Code="AUTH108NATIVEFORBIDDEN" Text="Native execution or framework-library recursion is outside this diagnostic." />
  </Target>
