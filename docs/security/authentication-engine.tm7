        <b:Priority>High</b:Priority>
        <b:Properties>
          <a:KeyValueOfstringstring>
            <a:Key>Title</a:Key>
            <a:Value>Data Flow Selected nonsecret Profile snapshot Is Potentially Interrupted</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatCategory</a:Key>
            <a:Value>Denial Of Service</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatShortDescription</a:Key>
            <a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatDescription</a:Key>
            <a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>InteractionString</a:Key>
            <a:Value>Selected nonsecret Profile snapshot</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>Priority</a:Key>
            <a:Value>High</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>StateInformation</a:Key>
            <a:Value>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#concrete-windows-slice and designs/windows-ado-authentication.md#profile-contract-and-ownership. An interrupted Profile read produces the existing invalid_request/configuration reason or timeout under the original deadline. Never use a partial/default Profile, restart the deadline, or fall back to another registration. The caller can correct the file and start a new request.</a:Value>
          </a:KeyValueOfstringstring>
        </b:Properties>
        <b:SourceGuid>d75e124f-6da6-49a0-8b8c-79a7431817dd</b:SourceGuid>
        <b:State>NeedsInvestigation</b:State>
        <b:StateInformation>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#concrete-windows-slice and designs/windows-ado-authentication.md#profile-contract-and-ownership. An interrupted Profile read produces the existing invalid_request/configuration reason or timeout under the original deadline. Never use a partial/default Profile, restart the deadline, or fall back to another registration. The caller can correct the file and start a new request.</b:StateInformation>
