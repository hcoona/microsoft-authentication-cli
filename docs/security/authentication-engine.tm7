    <a:KeyValueOfstringThreatpc_P0_PhOB>
      <a:Key>T189ad86cf2-fcc4-43dc-9c0d-ad1adda9cad31bef0ff4-65ae-49f7-a9dc-10d72e3b6edcee45e66c-433d-4dd9-af86-97260e5c54a8</a:Key>
      <a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase">
        <b:ChangedBy>Architecture review</b:ChangedBy>
        <b:DrawingSurfaceGuid>878daffd-a529-4789-883c-f6f01fdf0cd6</b:DrawingSurfaceGuid>
        <b:FlowGuid>1bef0ff4-65ae-49f7-a9dc-10d72e3b6edc</b:FlowGuid>
        <b:Id>67</b:Id>
        <b:InteractionKey>9ad86cf2-fcc4-43dc-9c0d-ad1adda9cad3:1bef0ff4-65ae-49f7-a9dc-10d72e3b6edc:ee45e66c-433d-4dd9-af86-97260e5c54a8</b:InteractionKey>
        <b:InteractionString i:nil="true"/>
        <b:ModifiedAt>2026-09-10T05:18:09Z</b:ModifiedAt>
        <b:Priority>High</b:Priority>
        <b:Properties>
          <a:KeyValueOfstringstring>
            <a:Key>Title</a:Key>
            <a:Value>The Platform-secure reusable state Data Store Could Be Corrupted</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatCategory</a:Key>
            <a:Value>Tampering</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatShortDescription</a:Key>
            <a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatDescription</a:Key>
            <a:Value>Data flowing across Secure state update may be tampered with by an attacker. This may lead to corruption of Platform-secure reusable state. Ensure the integrity of the data flow to the data store.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>InteractionString</a:Key>
            <a:Value>Secure state update</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>Priority</a:Key>
            <a:Value>High</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>StateInformation</a:Key>
            <a:Value>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#tmt-analysis-and-disposition. Rely on the selected secure-store update/locking contract; do not consume corrupt or incompatible state. Exercise concurrent V2 requests and safe recovery. V2-REQ-040, V2-REQ-041.</a:Value>
          </a:KeyValueOfstringstring>
        </b:Properties>
        <b:SourceGuid>9ad86cf2-fcc4-43dc-9c0d-ad1adda9cad3</b:SourceGuid>
        <b:State>NeedsInvestigation</b:State>
        <b:StateInformation>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#tmt-analysis-and-disposition. Rely on the selected secure-store update/locking contract; do not consume corrupt or incompatible state. Exercise concurrent V2 requests and safe recovery. V2-REQ-040, V2-REQ-041.</b:StateInformation>
        <b:TargetGuid>ee45e66c-433d-4dd9-af86-97260e5c54a8</b:TargetGuid>
