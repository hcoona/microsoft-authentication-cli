        <b:Priority>High</b:Priority>
        <b:Properties>
          <a:KeyValueOfstringstring>
            <a:Key>Title</a:Key>
            <a:Value>Data Flow Provider token and identity metadata Is Potentially Interrupted</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatCategory</a:Key>
            <a:Value>Denial Of Service</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatShortDescription</a:Key>
            <a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatDescription</a:Key>
            <a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>InteractionString</a:Key>
            <a:Value>Provider token and identity metadata</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>Priority</a:Key>
            <a:Value>High</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>StateInformation</a:Key>
            <a:Value>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#tmt-analysis-and-disposition. Treat interrupted flow as a bounded failure under the original deadline. No unlimited retry, wrong-account fallback, or late completion after cancellation. Telemetry failure cannot alter authentication success. V2-REQ-015, V2-REQ-023, V2-REQ-025, V2-REQ-046.</a:Value>
          </a:KeyValueOfstringstring>
        </b:Properties>
        <b:SourceGuid>570925d5-d317-49d6-8496-85bc25694a3d</b:SourceGuid>
        <b:State>NeedsInvestigation</b:State>
        <b:StateInformation>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#tmt-analysis-and-disposition. Treat interrupted flow as a bounded failure under the original deadline. No unlimited retry, wrong-account fallback, or late completion after cancellation. Telemetry failure cannot alter authentication success. V2-REQ-015, V2-REQ-023, V2-REQ-025, V2-REQ-046.</b:StateInformation>
        <b:TargetGuid>9ad86cf2-fcc4-43dc-9c0d-ad1adda9cad3</b:TargetGuid>
        <b:Title i:nil="true"/>
