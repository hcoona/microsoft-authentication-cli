        <b:Priority>High</b:Priority>
        <b:Properties>
          <a:KeyValueOfstringstring>
            <a:Key>Title</a:Key>
            <a:Value>Elevation by Changing the Execution Flow in Authentication engine + MSAL</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatCategory</a:Key>
            <a:Value>Elevation Of Privilege</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatShortDescription</a:Key>
            <a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatDescription</a:Key>
            <a:Value>An attacker may pass data into Authentication engine + MSAL in order to change the flow of program execution within Authentication engine + MSAL to the attacker's choosing.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>InteractionString</a:Key>
            <a:Value>State read and completion status</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>Priority</a:Key>
            <a:Value>High</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>StateInformation</a:Key>
            <a:Value>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#tmt-analysis-and-disposition. Keep request state and fallback classification explicit; untrusted results cannot redirect policy or resume terminated work. Rely on runtime/OS memory protections within the workstation threat model. V2-REQ-015, V2-REQ-023, V2-REQ-025.</a:Value>
          </a:KeyValueOfstringstring>
        </b:Properties>
        <b:SourceGuid>ee45e66c-433d-4dd9-af86-97260e5c54a8</b:SourceGuid>
        <b:State>NeedsInvestigation</b:State>
        <b:StateInformation>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#tmt-analysis-and-disposition. Keep request state and fallback classification explicit; untrusted results cannot redirect policy or resume terminated work. Rely on runtime/OS memory protections within the workstation threat model. V2-REQ-015, V2-REQ-023, V2-REQ-025.</b:StateInformation>
        <b:TargetGuid>9ad86cf2-fcc4-43dc-9c0d-ad1adda9cad3</b:TargetGuid>
