        <b:Priority>High</b:Priority>
        <b:Properties>
          <a:KeyValueOfstringstring>
            <a:Key>Title</a:Key>
            <a:Value>External Entity Microsoft identity platform Potentially Denies Receiving Data</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatCategory</a:Key>
            <a:Value>Repudiation</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatShortDescription</a:Key>
            <a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatDescription</a:Key>
            <a:Value>Microsoft identity platform claims that it did not receive data from a process on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>InteractionString</a:Key>
            <a:Value>Trusted-authority OAuth request</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>Priority</a:Key>
            <a:Value>High</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>StateInformation</a:Key>
            <a:Value>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#tmt-analysis-and-disposition. The engine does not provide nonrepudiation, signed delivery receipts, or an audit ledger. Caller-visible results and sanitized diagnostics serve the accepted contract. Adding identity-rich audit retention would expand scope and undermine V2-REQ-035/V2-REQ-036; V2-REQ-034 and V2-REQ-046 still govern output and telemetry.</a:Value>
          </a:KeyValueOfstringstring>
        </b:Properties>
        <b:SourceGuid>9ad86cf2-fcc4-43dc-9c0d-ad1adda9cad3</b:SourceGuid>
        <b:State>NotApplicable</b:State>
        <b:StateInformation>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#tmt-analysis-and-disposition. The engine does not provide nonrepudiation, signed delivery receipts, or an audit ledger. Caller-visible results and sanitized diagnostics serve the accepted contract. Adding identity-rich audit retention would expand scope and undermine V2-REQ-035/V2-REQ-036; V2-REQ-034 and V2-REQ-046 still govern output and telemetry.</b:StateInformation>
        <b:TargetGuid>093c7bab-4f22-47b0-b6db-abee6dc6a445</b:TargetGuid>
