        <b:Priority>High</b:Priority>
        <b:Properties>
          <a:KeyValueOfstringstring>
            <a:Key>Title</a:Key>
            <a:Value>Potential Process Crash or Stop for Authentication engine + MSAL</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatCategory</a:Key>
            <a:Value>Denial Of Service</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatShortDescription</a:Key>
            <a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatDescription</a:Key>
            <a:Value>Authentication engine + MSAL crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>InteractionString</a:Key>
            <a:Value>Selected nonsecret Profile snapshot</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>Priority</a:Key>
            <a:Value>High</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>StateInformation</a:Key>
            <a:Value>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#concrete-windows-slice and designs/windows-ado-authentication.md#profile-contract-and-ownership. Use a bounded 64 KiB strict JSON read and maintained parser, reject malformed/unsupported input before authentication, preserve the original monotonic deadline, and end the single process when bounded local shutdown cannot complete. Do not promise availability under a compromised OS or repair unrelated filesystem state.</a:Value>
          </a:KeyValueOfstringstring>
        </b:Properties>
        <b:SourceGuid>d75e124f-6da6-49a0-8b8c-79a7431817dd</b:SourceGuid>
