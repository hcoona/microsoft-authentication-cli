    <a:KeyValueOfstringThreatpc_P0_PhOB>
      <a:Key>S2d75e124f-6da6-49a0-8b8c-79a7431817dd411f0631-f389-414a-a8ca-1f6c930ce6859ad86cf2-fcc4-43dc-9c0d-ad1adda9cad3</a:Key>
      <a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase">
        <b:ChangedBy>Architecture review</b:ChangedBy>
        <b:DrawingSurfaceGuid>878daffd-a529-4789-883c-f6f01fdf0cd6</b:DrawingSurfaceGuid>
        <b:FlowGuid>411f0631-f389-414a-a8ca-1f6c930ce685</b:FlowGuid>
        <b:Id>88</b:Id>
        <b:InteractionKey>d75e124f-6da6-49a0-8b8c-79a7431817dd:411f0631-f389-414a-a8ca-1f6c930ce685:9ad86cf2-fcc4-43dc-9c0d-ad1adda9cad3</b:InteractionKey>
        <b:InteractionString i:nil="true"/>
        <b:ModifiedAt>2026-09-11T18:22:14Z</b:ModifiedAt>
        <b:Priority>High</b:Priority>
        <b:Properties>
          <a:KeyValueOfstringstring>
            <a:Key>Title</a:Key>
            <a:Value>Spoofing the Authentication engine + MSAL Process</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatCategory</a:Key>
            <a:Value>Spoofing</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatShortDescription</a:Key>
            <a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatDescription</a:Key>
            <a:Value>Authentication engine + MSAL may be spoofed by an attacker and this may lead to information disclosure by Explicit caller-managed Profile file. Consider using a standard authentication mechanism to identify the destination process.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>InteractionString</a:Key>
            <a:Value>Selected nonsecret Profile snapshot</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>Priority</a:Key>
            <a:Value>High</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>StateInformation</a:Key>
            <a:Value>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#concrete-windows-slice and designs/windows-ado-authentication.md#profile-contract-and-ownership. This flow contains deliberately public client/cloud/ownership configuration, not authentication material or account email. Disclosure of that configuration is not a protected asset. Executable selection and a spoofed authentication process remain covered by the existing caller/CLI spoofing threats; no mutual-authentication mechanism is added to a local public-file read.</a:Value>
          </a:KeyValueOfstringstring>
        </b:Properties>
        <b:SourceGuid>d75e124f-6da6-49a0-8b8c-79a7431817dd</b:SourceGuid>
        <b:State>NotApplicable</b:State>
        <b:StateInformation>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#concrete-windows-slice and designs/windows-ado-authentication.md#profile-contract-and-ownership. This flow contains deliberately public client/cloud/ownership configuration, not authentication material or account email. Disclosure of that configuration is not a protected asset. Executable selection and a spoofed authentication process remain covered by the existing caller/CLI spoofing threats; no mutual-authentication mechanism is added to a local public-file read.</b:StateInformation>
        <b:TargetGuid>9ad86cf2-fcc4-43dc-9c0d-ad1adda9cad3</b:TargetGuid>
        <b:Title i:nil="true"/>
        <b:TypeId>S2</b:TypeId>
        <b:Upgraded>false</b:Upgraded>
        <b:UserThreatCategory i:nil="true"/>
        <b:UserThreatDescription i:nil="true"/>
        <b:UserThreatShortDescription i:nil="true"/>
        <b:Wide>false</b:Wide>
      </a:Value>
    </a:KeyValueOfstringThreatpc_P0_PhOB>
    <a:KeyValueOfstringThreatpc_P0_PhOB>
      <a:Key>S7d75e124f-6da6-49a0-8b8c-79a7431817dd411f0631-f389-414a-a8ca-1f6c930ce6859ad86cf2-fcc4-43dc-9c0d-ad1adda9cad3</a:Key>
      <a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase">
        <b:ChangedBy>Architecture review</b:ChangedBy>
        <b:DrawingSurfaceGuid>878daffd-a529-4789-883c-f6f01fdf0cd6</b:DrawingSurfaceGuid>
        <b:FlowGuid>411f0631-f389-414a-a8ca-1f6c930ce685</b:FlowGuid>
        <b:Id>89</b:Id>
        <b:InteractionKey>d75e124f-6da6-49a0-8b8c-79a7431817dd:411f0631-f389-414a-a8ca-1f6c930ce685:9ad86cf2-fcc4-43dc-9c0d-ad1adda9cad3</b:InteractionKey>
        <b:InteractionString i:nil="true"/>
        <b:ModifiedAt>2026-09-11T18:22:14Z</b:ModifiedAt>
        <b:Priority>High</b:Priority>
        <b:Properties>
          <a:KeyValueOfstringstring>
            <a:Key>Title</a:Key>
            <a:Value>Spoofing of Source Data Store Explicit caller-managed Profile file</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatCategory</a:Key>
            <a:Value>Spoofing</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatShortDescription</a:Key>
            <a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatDescription</a:Key>
            <a:Value>Explicit caller-managed Profile file may be spoofed by an attacker and this may lead to incorrect data delivered to Authentication engine + MSAL. Consider using a standard authentication mechanism to identify the source data store.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>InteractionString</a:Key>
            <a:Value>Selected nonsecret Profile snapshot</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>Priority</a:Key>
            <a:Value>High</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>StateInformation</a:Key>
            <a:Value>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#concrete-windows-slice and designs/windows-ado-authentication.md#profile-contract-and-ownership. The caller explicitly selects one local Windows Profile file. Validate one bounded immutable snapshot, trusted cloud, client/integration compatibility and tenant policy before provider work. Rely on normal Windows file permissions within the same-user threat model. No URL/configuration discovery, inherited defaults, executable configuration or upstream import. Validate configuration tampering and wrong-client scenarios.</a:Value>
          </a:KeyValueOfstringstring>
        </b:Properties>
        <b:SourceGuid>d75e124f-6da6-49a0-8b8c-79a7431817dd</b:SourceGuid>
        <b:State>NeedsInvestigation</b:State>
        <b:StateInformation>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#concrete-windows-slice and designs/windows-ado-authentication.md#profile-contract-and-ownership. The caller explicitly selects one local Windows Profile file. Validate one bounded immutable snapshot, trusted cloud, client/integration compatibility and tenant policy before provider work. Rely on normal Windows file permissions within the same-user threat model. No URL/configuration discovery, inherited defaults, executable configuration or upstream import. Validate configuration tampering and wrong-client scenarios.</b:StateInformation>
        <b:TargetGuid>9ad86cf2-fcc4-43dc-9c0d-ad1adda9cad3</b:TargetGuid>
        <b:Title i:nil="true"/>
        <b:TypeId>S7</b:TypeId>
        <b:Upgraded>false</b:Upgraded>
