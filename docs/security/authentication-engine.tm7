      <a:ThreatType>
        <a:IsExtension>false</a:IsExtension>
        <a:Category>T</a:Category>
        <a:Description>Log readers can come under attack via log files. Consider ways to canonicalize data in all logs. Implement a single reader for the logs, if possible, in order to reduce attack surface area. Be sure to understand and document log file elements which come from untrusted sources.</a:Description>
        <a:GenerationFilters>
          <a:Exclude/>
          <a:Include>(source is 'GE.P' and target is 'GE.DS' and target.storesLogData is 'Yes') or (target is 'GE.P' and source is 'GE.DS' and source.storesLogData is 'Yes')</a:Include>
        </a:GenerationFilters>
