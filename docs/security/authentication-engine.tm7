    <a:KeyValueOfstringThreatpc_P0_PhOB>
      <a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b0261093c7bab-4f22-47b0-b6db-abee6dc6a445e3e96e05-79d4-4d58-bb5d-6c0b2352cfe89ad86cf2-fcc4-43dc-9c0d-ad1adda9cad3</a:Key>
      <a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase">
        <b:ChangedBy>Architecture review</b:ChangedBy>
        <b:DrawingSurfaceGuid>878daffd-a529-4789-883c-f6f01fdf0cd6</b:DrawingSurfaceGuid>
