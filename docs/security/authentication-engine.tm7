        <b:Id>33</b:Id>
        <b:InteractionKey>a9870bbe-d106-4687-b515-59f5d210bf53:00607525-70dd-4a0d-b890-1c3ecb157ef6:9ad86cf2-fcc4-43dc-9c0d-ad1adda9cad3</b:InteractionKey>
        <b:InteractionString i:nil="true"/>
        <b:ModifiedAt>2026-09-10T05:18:09Z</b:ModifiedAt>
        <b:Priority>High</b:Priority>
        <b:Properties>
          <a:KeyValueOfstringstring>
            <a:Key>Title</a:Key>
            <a:Value>Spoofing the Browser / user interaction External Entity</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatCategory</a:Key>
            <a:Value>Spoofing</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatShortDescription</a:Key>
            <a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatDescription</a:Key>
            <a:Value>Browser / user interaction may be spoofed by an attacker and this may lead to unauthorized access to Authentication engine + MSAL. Consider using a standard authentication mechanism to identify the external entity.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>InteractionString</a:Key>
            <a:Value>Request-bound completion</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>Priority</a:Key>
            <a:Value>High</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>StateInformation</a:Key>
            <a:Value>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#tmt-analysis-and-disposition. Treat request inputs and completion messages as constrained input. Use trusted broker/authority APIs and validate the provider-observed account, tenant, and scopes before delivery. V2-REQ-011A, V2-REQ-020, V2-REQ-022, V2-REQ-027.</a:Value>
          </a:KeyValueOfstringstring>
        </b:Properties>
        <b:SourceGuid>a9870bbe-d106-4687-b515-59f5d210bf53</b:SourceGuid>
        <b:State>NeedsInvestigation</b:State>
        <b:StateInformation>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#tmt-analysis-and-disposition. Treat request inputs and completion messages as constrained input. Use trusted broker/authority APIs and validate the provider-observed account, tenant, and scopes before delivery. V2-REQ-011A, V2-REQ-020, V2-REQ-022, V2-REQ-027.</b:StateInformation>
        <b:TargetGuid>9ad86cf2-fcc4-43dc-9c0d-ad1adda9cad3</b:TargetGuid>
