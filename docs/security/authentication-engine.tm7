        <b:Properties>
          <a:KeyValueOfstringstring>
            <a:Key>Title</a:Key>
            <a:Value>Elevation Using Impersonation</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatCategory</a:Key>
            <a:Value>Elevation Of Privilege</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatShortDescription</a:Key>
            <a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>UserThreatDescription</a:Key>
            <a:Value>Authentication engine + MSAL may be able to impersonate the context of Microsoft identity platform in order to gain additional privilege.</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>InteractionString</a:Key>
            <a:Value>Token and provider metadata response</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>Priority</a:Key>
            <a:Value>High</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
            <a:Key>StateInformation</a:Key>
            <a:Value>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#tmt-analysis-and-disposition. The CLI executes within the existing OS user context; no service-side impersonation or elevation feature is introduced. Review broker integration and request boundaries without assuming the application can defeat an already compromised OS session. V2-REQ-001, V2-REQ-016.</a:Value>
          </a:KeyValueOfstringstring>
        </b:Properties>
        <b:SourceGuid>093c7bab-4f22-47b0-b6db-abee6dc6a445</b:SourceGuid>
        <b:State>NeedsInvestigation</b:State>
        <b:StateInformation>Design review only; no runtime mitigation is claimed. See docs/security/threat-model.md#tmt-analysis-and-disposition. The CLI executes within the existing OS user context; no service-side impersonation or elevation feature is introduced. Review broker integration and request boundaries without assuming the application can defeat an already compromised OS session. V2-REQ-001, V2-REQ-016.</b:StateInformation>
        <b:TargetGuid>9ad86cf2-fcc4-43dc-9c0d-ad1adda9cad3</b:TargetGuid>
